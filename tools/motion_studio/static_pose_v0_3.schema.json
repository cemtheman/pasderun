{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pasderun.local/motion-studio/static-pose-v0-3.schema.json",
  "title": "Motion Studio v0.3 two-link static arm target",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "pose_id", "rig_profile_id", "targets"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "pose_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "rig_profile_id": {"type": "string", "minLength": 1},
    "targets": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/target"}}
  },
  "$defs": {
    "target": {"type": "object", "additionalProperties": false,
      "required": ["side", "landmark", "reach_fraction", "offset_body_arm_reach", "bend_plane"],
      "properties": {
        "side": {"enum": ["left", "right"]},
        "landmark": {"enum": ["left_wrist", "right_wrist"]},
        "reach_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.95},
        "offset_body_arm_reach": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "bend_plane": {"enum": ["body_front", "body_back", "body_up", "body_down"]}
      }
    }
  }
}
