  "turnout_model": {
    "external_rotation_sign": "positive",
    "primary_authority": "hip_ball.internal_external_rotation",
    "hip_external_rotation": {
      "preferred_max_per_leg_deg": 60,
      "hard_max_per_leg_deg": 80
    },
    "knee_axial_coupling": {
      "solver_authority": "derived_only",
      "independent_solver_dof": false,
      "max_external_rotation_at_extension_deg": 5,
      "max_external_rotation_at_90_flexion_deg": 18,
      "interpolation": "linear_clamped_0_to_90_flexion",
      "reason": "tibiofemoral axial contribution is flexion-dependent and must not become free turnout authority"
    },
    "ankle_foot": {
      "independent_yaw_dof": false,
      "turnout_generation_by_foot_yaw_forbidden": true,
      "foot_contact_must_follow_upstream_chain": true,
      "pronation_is_not_turnout_authority": true
    },
    "solver_priority": [
      "preserve_contact_and_knee_alignment",
      "use_hip_external_rotation",
      "allow_limited_flexion_dependent_knee_coupling",
      "preserve_ankle_foot_alignment"
    ]
  },
  "coupling_constraints": {
    "knee_second_toe_tracking": {
      "enabled": true,
      "reference": "knee center projected toward second-toe ray",
      "preferred_angular_error_deg": 6,
      "hard_angular_error_deg": 12
    },
    "shoulder_clavicle_coordination": {
      "enabled": true,
      "humeral_elevation_requires_clavicle_participation_above_deg": 70,
      "clavicle_share_is_solver_coupled_not_fixed_ratio": true
    },
    "wrist_forearm_continuity": {
      "enabled": true,
      "hand_axial_roll_source": "forearm_pronation_supination_plus_retarget_bind",
      "independent_hand_axial_roll_forbidden": true
    }
  },
