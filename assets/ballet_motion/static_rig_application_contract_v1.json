    "ankle_contact_correction_must_stay_preferred": true,
    "releve_contact_realization_required": true,
    "releve_heel_height_source": "Phase 10.6.5 semantic heel-height scalar realized against deformed mesh",
    "releve_plantar_solver_preferred_only": true,
    "releve_toe_flexion_preserved_from_retarget": false,
    "full_foot_mesh_contact_plane_is_final_authority": true,
    "full_foot_realized_bone_up_alignment_is_not_contact_authority": true,
    "releve_toe_solver_preferred_only": true,
    "releve_semantic_joint_targets_are_preferences_after_contact": true,
    "standing_arm_poses_full_foot_contact_required": true,
    "plie_pelvis_descent_source": "Phase 10.6.5 leg-chain-scaled semantic scalar",
    "plie_full_foot_contact_is_final_root_translation_authority": true,
    "hand_mesh_centerline_spacing_required_for_bras_bas_and_en_avant": true,
    "hand_mesh_is_final_visual_centerline_authority": true,
    "middle_bone_tail_is_diagnostic_not_visual_authority": true,
    "hand_mesh_wrist_realization_required": false,
    "hand_mesh_wrist_solver_preferred_only": false,
    "middle_bone_tip_is_diagnostic_after_mesh_realization": true,
    "hand_mesh_vertices_source": "all deformed mesh vertices weighted to Hand_L/Hand_R and every descendant rig bone",
    "partial_hand_or_single_finger_sampling_forbidden": true,
    "hand_mesh_runtime_clearance_solver_required": true,
    "hand_mesh_runtime_clearance_not_authored": true,
    "hand_mesh_runtime_solver_reuses_phase_10_6_5_and_10_6_6": false,
    "hand_mesh_secondary_wrist_trim_forbidden": true,
    "hand_mesh_retarget_wrist_seed_preserved_required": true,
    "hand_mesh_runtime_clearance_parameterization_continuous": true,
    "hand_mesh_runtime_clearance_fibonacci_direction_sampling_forbidden": true,
    "hand_mesh_runtime_bilateral_side_specific_solution_allowed": true,
