    "hand_mesh_primary_joint_authority": "SHOULDER_SWEEP_ONLY",
    "hand_mesh_elbow_local_bend_preserved": true,
    "hand_mesh_wrist_local_bend_preserved": true,
    "hand_mesh_mesh_driven_elbow_or_wrist_correction_forbidden": true
  },
  "contact_sampling": {
    "minimum_vertex_group_weight": 0.15,
    "rear_fraction": 0.35,
    "fore_fraction": 0.35,
    "low_height_quantile": 0.1
  },
  "root_translation_modes": {
    "bras_bas": "SOLVE_FULL_FOOT_CONTACT",
    "en_avant": "SOLVE_FULL_FOOT_CONTACT",
    "second": "SOLVE_FULL_FOOT_CONTACT",
    "fifth": "SOLVE_FULL_FOOT_CONTACT",
    "plie": "SOLVE_FULL_FOOT_CONTACT",
    "releve": "SOLVE_FOREFOOT_CONTACT"
  },
  "proof_thresholds": {
    "local_rotation_matrix_error_max": 0.00001,
    "absolute_rotation_matrix_error_max": 0.00005,
    "contact_error_max_foot_length_fraction": 0.06,
    "fifth_root_shift_max_leg_length_fraction": 0.08,
    "plie_descent_relative_error_max": 0.4,
    "plie_descent_absolute_leg_fraction_max": 0.08,
    "releve_heel_lift_relative_error_max": 0.45,
    "releve_heel_lift_absolute_foot_fraction_max": 0.2,
    "releve_heel_must_rise_min_foot_fraction": 0.05,
    "releve_plantar_search_coarse_step_deg": 2,
    "full_foot_seed_up_alignment_min_dot": 0.999999,
    "full_foot_mesh_search_coarse_step_deg": 1,
    "full_foot_mesh_search_refine_steps_deg": [
      0.1,
      0.01,
      0.001
    ],
    "releve_toe_search_coarse_step_deg": 5,
    "releve_joint_search_refine_steps_deg": [
      1,
      0.2,
      0.05
    ]
  },
  "hand_mesh_sampling": {
    "minimum_vertex_group_weight": 0.15,
    "inner_edge_quantile": 0.02,
    "bone_scope": "HAND_ROOT_PLUS_ALL_DESCENDANTS"
  },
  "hand_mesh_wrist_solver": {
    "coarse_step_deg": 5,
    "refine_steps_deg": [
      1,
      0.2,
      0.05
    ],
    "interval_error_epsilon": 0.000001,
    "independent_axial_roll_forbidden": true
  },
  "hand_mesh_runtime_clearance_solver": {
    "method": "INDEPENDENT_PRIMARY_SHOULDER_SWEEP_BISECTION",
    "root_iterations": 24,
    "target": "HALF_OF_DECLARED_BILATERAL_GAP_MIDPOINT_PER_SIDE",
    "shoulder_axis_by_pose": {
      "bras_bas": "BODY_FRONT",
      "en_avant": "BODY_UP"
    },
    "shoulder_sweep_bound": "MINIMUM_REMAINING_MARGIN_TO_PHASE_10_6_3_PREFERRED_SHOULDER_DOF_BOUND_FROM_PHASE_10_6_5_SEMANTIC_UPPER_ARM_DOFS",
    "preserved_local_chain": [
      "forearm",
      "hand"
    ],
    "independent_axial_roll_forbidden": true
  }
