{
  "schema_version": 1,
  "phase": "10.6.6",
  "contract_id": "canonical_to_calibrated_rig_orientation_v1",
  "policy": {
    "canonical_pose_source": "Phase 10.6.5 validated solutions only",
    "upper_limb_orientation_source": "upper arm/forearm landmark frames with declared axial roll; hand landmark direction solved exactly through wrist_2dof",
