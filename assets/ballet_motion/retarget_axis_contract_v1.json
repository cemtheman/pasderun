        "scale": 1,
        "side_sign": false
      },
      {
        "dof": "abduction_adduction",
        "axis": "Z",
        "scale": 1,
        "side_sign": true
      },
      {
        "dof": "internal_external_rotation",
        "axis": "Y",
        "scale": 1,
        "side_sign": true
      }
    ],
    "knee_hinge": [
      {
        "dof": "flexion_extension",
        "axis": "X",
        "scale": -1,
        "side_sign": false
      },
      {
        "derived": "knee_external_rotation_deg",
        "axis": "Y",
        "scale": 1,
        "side_sign": true
      }
    ],
    "ankle_2dof": [
      {
        "dof": "plantar_dorsiflexion",
        "axis": "X",
        "scale": -1,
        "side_sign": false
