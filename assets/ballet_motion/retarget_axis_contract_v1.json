      {
        "dof": "inversion_eversion",
        "axis": "Y",
        "scale": 1,
        "side_sign": true
      }
    ],
    "mtp_hinge": [
      {
        "dof": "toe_flexion_extension",
        "axis": "X",
        "scale": 1,
        "side_sign": false
      }
    ]
  },
  "upper_limb_roll": {
