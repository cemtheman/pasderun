{
  "schema_version": 1,
  "phase": "10.6.6",
  "contract_id": "canonical_to_calibrated_rig_orientation_v1",
  "policy": {
    "canonical_pose_source": "Phase 10.6.5 validated solutions only",
    "upper_limb_orientation_source": "landmark-derived absolute canonical frames",
    "lower_limb_orientation_source": "canonical local joint DOFs plus derived knee turnout coupling",
    "euler_application_forbidden": true,
    "matrix_and_quaternion_output_only": true,
    "retarget_bind_source": "Phase 10.6.2 per-bone calibrated bind",
    "rest_identity_required": true,
    "canonical_roundtrip_required": true,
    "parent_relative_rig_delta_required": true,
    "orientation_retarget_only": true,
    "non_rotational_pose_contract_passthrough": true,
    "root_translation_applied": false,
    "contact_translation_applied": false,
    "blender_application_forbidden": true,
    "render_forbidden": true,
    "animation_forbidden": true
  },
  "composition": {
    "convention": "POSTMULTIPLY_LOCAL_ROTATIONS_IN_LISTED_ORDER",
