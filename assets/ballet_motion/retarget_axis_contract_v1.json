      "source_dof": "internal_external_rotation",
      "axis": "POSED_LENGTH_Y"
    },
    "forearm": {
      "source_dof": "pronation_supination",
      "axis": "POSED_LENGTH_Y"
    },
    "hand": {
      "source_dof": null,
      "axis": null
    }
  },
  "thresholds": {
    "orthogonality_max_error": 0.00001,
    "determinant_min": 0.9999,
    "determinant_max": 1.0001,
    "bind_roundtrip_max_error": 0.00001,
    "hierarchy_reconstruction_max_error": 0.00001,
    "arm_length_axis_alignment_min_dot": 0.99999,
    "rest_identity_max_error": 0.00001
  }
